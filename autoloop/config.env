# Configuración del loop autónomo (autoloop/autoloop.sh).
# Cualquier variable se puede sobreescribir desde el entorno:
#   MAX_ITERATIONS=1 autoloop/autoloop.sh start
# No pongas claves ni tokens en este archivo: se commitea.

# --- Límites de ejecución ---
MAX_ITERATIONS="${MAX_ITERATIONS:-5}"                 # iteraciones por corrida (nunca ilimitado)
PAUSE_SECONDS="${PAUSE_SECONDS:-30}"                  # pausa entre iteraciones
ITERATION_TIMEOUT="${ITERATION_TIMEOUT:-1800}"        # segundos máximos por invocación de Claude
MAX_ATTEMPTS_PER_TASK="${MAX_ATTEMPTS_PER_TASK:-3}"   # luego la tarea queda fuera hasta revisión humana
MAX_NO_PROGRESS="${MAX_NO_PROGRESS:-2}"               # iteraciones seguidas sin cambios -> detener

# --- Presupuesto (estimación que reporta Claude Code en total_cost_usd) ---
MAX_BUDGET_PER_ITERATION_USD="${MAX_BUDGET_PER_ITERATION_USD:-2.00}"  # se pasa a --max-budget-usd
MAX_BUDGET_PER_RUN_USD="${MAX_BUDGET_PER_RUN_USD:-8.00}"              # se detiene antes de superarlo

# --- Claude Code ---
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
CLAUDE_MODEL="${CLAUDE_MODEL:-}"                       # vacío = modelo por defecto de la cuenta
PERMISSION_MODE="${PERMISSION_MODE:-acceptEdits}"      # NUNCA bypassPermissions por defecto
# Herramientas permitidas sin preguntar. Lo que no está acá se deniega en modo no interactivo.
ALLOWED_TOOLS="${ALLOWED_TOOLS:-Read Edit Write Glob Grep TodoWrite Bash(python3:*) Bash(python:*) Bash(pytest:*) Bash(bash autoloop/tests/run_tests.sh) Bash(git status:*) Bash(git diff:*) Bash(git log:*) Bash(git show:*) Bash(ls:*) Bash(wc:*) Bash(head:*) Bash(tail:*) Bash(mkdir:*) Bash(npm test:*) Bash(npm run:*)}"
# Denegadas explícitamente: publicar, reescribir historia, borrar en masa, red.
DISALLOWED_TOOLS="${DISALLOWED_TOOLS:-Bash(git push:*) Bash(git commit:*) Bash(git reset:*) Bash(git checkout:*) Bash(git clean:*) Bash(git rebase:*) Bash(rm:*) Bash(curl:*) Bash(wget:*) Bash(ssh:*) Bash(scp:*) Bash(sudo:*) WebFetch WebSearch}"

# --- Git ---
AUTO_COMMIT="${AUTO_COMMIT:-1}"   # commitear al final de cada iteración exitosa (local)
AUTO_PUSH="${AUTO_PUSH:-0}"       # 0 = nunca pushear solo. Ponelo en 1 solo en una rama de trabajo.
PUSH_BRANCH="${PUSH_BRANCH:-}"    # rama a la que se permite pushear (obligatorio si AUTO_PUSH=1)

# --- Verificación de regresiones (se corre después de cada iteración) ---
REGRESSION_CMD="${REGRESSION_CMD:-bash autoloop/tests/run_tests.sh && if [ -d tests ]; then python3 -m unittest discover -s tests -t . -q; fi}"

# --- Modo de prueba ---
# TEST_MODE=1: se le indica al agente que no envíe emails/WhatsApp/campañas ni use servicios externos,
# y se le niega acceso web. Con --mock ni siquiera se invoca a Claude.
TEST_MODE="${TEST_MODE:-0}"
